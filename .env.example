# ─── Resend (Contact Form Email) ───────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The email that receives contact form submissions
CONTACT_RECIPIENT_EMAIL="Info@Sq-Solution.Com"

# The "from" address (must be a verified domain in Resend)
CONTACT_SENDER_EMAIL="noreply@sq-solution.com"

# ─── Social Media URLs ─────────────────────────────────────────
# Public URLs used in footer, contact section, etc.
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/your-page"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/your-company"
